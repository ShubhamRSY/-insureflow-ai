# Production / bank posture template — copy to .env and fill real secrets.
# Never commit the real .env.

ENVIRONMENT=production
BANK_MODE=true
SECRET_KEY=REPLACE_WITH_UNIQUE_SECRET_AT_LEAST_32_CHARS
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
INTEGRATION_GATEWAY_API_KEY=REPLACE_WITH_STRONG_GATEWAY_SECRET

ALLOW_OPEN_REGISTRATION=false
ALLOW_AUTH_RESET=false
ALLOW_SIMULATED_BIND=false
LOAD_DEMO_PORTFOLIO=false
REQUIRE_LIVE_ORACLES=false
# Pilot: analyze + UW sign-off only; block bind until PAS is live
PILOT_SHADOW_MODE=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
MIN_PASSWORD_LENGTH=12

JOB_STORE_BACKEND=redis
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
CELERY_BROKER_URL=redis://YOUR_REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=redis://YOUR_REDIS_HOST:6379/0
AUDIT_LOG_PATH=./audit_logs
STORAGE_BACKEND=file

ORACLE_MODE=auto
CLUE_API_KEY=REPLACE
CLUE_API_URL=https://integrations.rytera.ai/oracles/clue/v2
APLUS_API_KEY=REPLACE
APLUS_API_URL=https://integrations.rytera.ai/oracles/aplus/v2
NCCI_API_KEY=REPLACE
NCCI_API_URL=https://integrations.rytera.ai/oracles/ncci/v2
CAT_API_KEY=REPLACE
CAT_API_URL=https://integrations.rytera.ai/oracles/cat/v1
ISO_RATING_API_KEY=REPLACE
ISO_RATING_API_URL=https://integrations.rytera.ai/oracles/iso/v1
ISO_RATING_MODE=auto

GUIDEWIRE_API_KEY=REPLACE
GUIDEWIRE_API_URL=https://integrations.rytera.ai/policy/guidewire/v1
GUIDEWIRE_MODE=auto
BRITECORE_API_KEY=REPLACE
BRITECORE_API_URL=https://integrations.rytera.ai/policy/britecore/v2
BRITECORE_MODE=auto

SSO_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.rytera.ai/auth/sso/callback
