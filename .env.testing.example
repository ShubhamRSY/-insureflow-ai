# Testing environment — hermetic, CI/QA
# Used with docker-compose.testing.yml or isolated pytest runs

ENVIRONMENT=testing
BANK_MODE=false

# LLM config (tests must not hit paid APIs; use local/simulated where possible)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Security
SECRET_KEY=test-secret-key-not-for-production-at-least-32-chars-xxxxx
MIN_PASSWORD_LENGTH=12
ALLOWED_HOSTS=localhost,127.0.0.1

# Auth & features
ALLOW_OPEN_REGISTRATION=true
ALLOW_AUTH_RESET=true
ALLOW_SIMULATED_BIND=true
LOAD_DEMO_PORTFOLIO=false
OPERATING_MODE=ready
PILOT_SHADOW_MODE=false

# Oracles (simulate only)
ORACLE_MODE=simulated
REQUIRE_LIVE_ORACLES=false

# Storage/infra (ephemeral, isolated)
AUDIT_LOG_PATH=./.tmp/testing/audit_logs
BROKER_EMAIL_OUTBOX=./.tmp/testing/broker_outbox
STORAGE_BACKEND=file
JOB_STORE_BACKEND=file
JOB_STORE_PATH=./.tmp/testing/job_store
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/0
CELERY_RESULT_BACKEND=redis://localhost:6381/0
DATABASE_URL=postgresql://insureflow:insureflow@localhost:5434/insureflow_test

# Comms (no external email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=test@rytera.local
SMTP_USE_TLS=false
LEAD_NOTIFY_TO=test@rytera.local

# Observability off
LANGSMITH_TRACING=false
CLOUDWATCH_LOGS=false

# Server
API_PORT=8012
