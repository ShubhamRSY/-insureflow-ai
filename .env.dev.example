# Dev environment — local development
# Usage: cp .env.dev.example .env.dev (or just set env vars)

ENVIRONMENT=development
BANK_MODE=false

# LLM config (defaults safe for dev)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Security (dev-friendly)
SECRET_KEY=CHANGE_ME_IN_DEV_LOCAL_ONLY_32_CHARS_MINIMUM_XXXXXXXXXXXXXXXX
MIN_PASSWORD_LENGTH=12
ALLOWED_HOSTS=localhost,127.0.0.1

# Auth & features
ALLOW_OPEN_REGISTRATION=true
ALLOW_AUTH_RESET=true
ALLOW_SIMULATED_BIND=true
LOAD_DEMO_PORTFOLIO=true
OPERATING_MODE=ready
PILOT_SHADOW_MODE=false

# Oracles
ORACLE_MODE=auto
REQUIRE_LIVE_ORACLES=false

# Storage/infra
AUDIT_LOG_PATH=./audit_logs/dev
AUDIT_RETENTION_DAYS=90
STORAGE_BACKEND=file
JOB_STORE_BACKEND=auto
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
DATABASE_URL=postgresql://insureflow:insureflow@localhost:5433/insureflow_dev

# Comms/outboxes
BROKER_EMAIL_OUTBOX=./audit_logs/dev/broker_outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=underwriting@dev.rytera.local
SMTP_USE_TLS=true
LEAD_NOTIFY_TO=shubham@ryterainc.com

# Observability (opt-in)
LANGSMITH_TRACING=false
CLOUDWATCH_LOGS=false

# Server
API_PORT=8002
