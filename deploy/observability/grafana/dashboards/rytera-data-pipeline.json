{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Queue health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasks waiting in each Celery/Redis queue (LLEN) — not yet claimed by any worker. A sustained climb on pipeline-large with pipeline flat means large submissions are backing up without starving normal traffic; a climb on pipeline itself while pipeline-large is idle usually means worker capacity, not routing, is the problem.",
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }, "decimals": 0, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pipeline-large" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 101,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rytera_celery_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Celery queue depth (tasks waiting)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Where dispatched jobs actually ran. queue=in_process,backend=in_process means Celery was unavailable and the job ran inside the API process (see rytera_inprocess_job_slots_in_use for how saturated that fallback is). A rising in_process share is the earliest signal of a broker outage.",
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 102,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(rytera_pipeline_dispatch_total[5m])) by (queue, backend)",
          "legendFormat": "{{queue}} / {{backend}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline dispatch rate by queue/backend",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "How many in-process (BackgroundTasks) pipeline runs are executing right now, out of INSURANCE_MAX_INPROCESS_JOBS. Pinned at the max for a sustained period means the API process is CPU/memory-throttling submissions during a broker outage — expected behavior, but worth knowing it's happening.",
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 }, "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 103,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rytera_inprocess_job_slots_in_use",
          "legendFormat": "in-process slots in use",
          "refId": "A"
        }
      ],
      "title": "In-process fallback saturation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Job outcomes by namespace/status from the job store (Redis-backed). A rising 'failed' line alongside a rising pipeline-large queue depth suggests large jobs are timing out even with the extended time limit.",
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 104,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rytera_jobs",
          "legendFormat": "{{namespace}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Job store (by namespace/status)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 200,
      "panels": [],
      "title": "Document intake quality & size",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Inline document submissions rejected for exceeding the 25MB per-document cap (draft_bundle_store.MAX_DOCUMENT_BYTES), by endpoint. A steady stream here means clients are hitting the direct-submission endpoints with large files instead of using the presigned-upload flow — a client-education or docs gap, not a server bug.",
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 }, "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 201,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rytera_oversized_document_rejections_total[1h])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Oversized-document rejections (per hour, by endpoint)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "DocQualityGate decisions before extraction runs. A rising 'block' share means intake quality is degrading upstream (bad scans, broker email attachments, OCR failures) — worth a look before it shows up as extraction failures downstream.",
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 202,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(rytera_doc_quality_decisions_total[15m])) by (decision) / clamp_min(sum(rate(rytera_doc_quality_decisions_total[15m])), 0.0001)",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "title": "Document quality decision mix (pass/warn/block)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Raw quality-gate decision volume — use alongside the ratio panel to distinguish 'block rate went up' from 'traffic went up and blocks scaled with it.'",
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "id": 203,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rytera_doc_quality_decisions_total[1h])) by (decision)",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "title": "Document quality decisions (per hour)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 300,
      "panels": [],
      "title": "Platform (HTTP + underwriting outcomes)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 301,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(rytera_http_requests_total[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 302,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(rytera_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(rytera_http_requests_total[5m])), 0.0001)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "title": "HTTP error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 303,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(rytera_http_request_duration_seconds_bucket{path=~\"/pipeline.*\"}[5m])) by (le, path))",
          "legendFormat": "{{path}} p95",
          "refId": "A"
        }
      ],
      "title": "Pipeline endpoint p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 304,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(rytera_pipeline_runs_total[5m])) by (line, decision)",
          "legendFormat": "{{line}} {{decision}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline completions",
      "type": "timeseries"
    }
  ],
